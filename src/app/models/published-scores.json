{
  "_readme": "Published figures for the models the platform serves. Single source of truth: the models page renders from this, and scripts/model-coverage.mjs checks the live catalogue against it. Run `npm run models:coverage` after adding a model — it names what is missing and where to put it. Every number here must be quotable from the source named on its family; a model with no published figure gets no entry and goes unplotted, which is the correct outcome.",
  "benchmark": {
    "name": "GPQA Diamond",
    "why": "The one benchmark all four families report, so every mark on the axis was measured the same way."
  },
  "sizePattern": "(\\d+(?:\\.\\d+)?)\\s*b(?![a-z0-9])",
  "reasoningPattern": "reason|think",
  "aliases": {
    "slp-orchestra-mini": "SL-mini"
  },
  "paramOverrides": {},
  "families": [
    {
      "key": "gemma4",
      "label": "Gemma 4",
